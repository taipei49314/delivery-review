{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:delivery-review:github-observation-profile:1",
  "title": "SPEC-001 GitHub observation profile 1; not a readiness policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "profile_version", "profile_id", "api_version", "repository", "source_mode", "selection", "workflows", "limits"],
  "properties": {
    "kind": {"const": "delivery-review-github-observation-profile"},
    "profile_version": {"type": "integer", "const": 1},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"},
    "api_version": {"const": "2026-03-10"},
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["id", "full_name"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "full_name": {"type": "string", "maxLength": 256,
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])",
                      "not": {"pattern": "(^|/)\\.{1,2}(/|$)"}}
      }
    },
    "source_mode": {"const": "pr_head"},
    "selection": {"const": "latest_applicable_run_number_v1"},
    "workflows": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "event", "app_id", "job_names"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "maxLength": 256, "pattern": "^\\.github/workflows/[A-Za-z0-9_][A-Za-z0-9_.-]*\\.ya?ml(?![\\s\\S])"},
          "event": {"const": "pull_request"},
          "app_id": {"$ref": "#/$defs/id"},
          "job_names": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["per_page", "max_pages", "max_response_bytes", "max_total_bytes", "max_requests", "timeout_seconds"],
      "properties": {
        "per_page": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 200},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30}
      }
    }
  },
  "$defs": {"id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
}
